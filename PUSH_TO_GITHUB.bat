@echo off
chcp 65001 > nul
title PUSH MONOPRICE TO GITHUB / VERCEL
cd /d "%~dp0"

echo ==============================================================================
echo             🌐 رفع التحديثات الجديدة إلى GITHUB / VERCEL 🌐
echo ==============================================================================
echo  سيتم الآن رفع الملفات المحدثة بالكامل إلى حسابك على GitHub
echo.
echo  ملاحظة: إذا ظهر لك خطأ 403، سيفتح لك جيت نافذة تسجيل الدخول لحساب depanto2025
echo ==============================================================================
echo.

git push -u origin main

if %ERRORLEVEL% NEQ 0 (
    echo.
    echo ==============================================================================
    echo  ⚠️ فشل الرفع التلقائي بسبب اختلاف حساب GitHub المخزن في الويندوز.
    echo  لتسجيل الدخول بالحساب الصحيح depanto2025 اضغط 1 ثم Enter لحذف الجلسة القديمة:
    echo ==============================================================================
    set /p choice="أدخل 1 للمصادقة بحساب depanto2025 أو أي زر للإلغاء: "
    if "%choice%"=="1" (
        cmdkey /delete:git:https://github.com
        echo تم حذف الاعتماد القديم، جاري إعادة المحاولة...
        git push -u origin main
    )
)

echo.
echo ==============================================================================
echo  تم الرفع بنجاح! سيقوم Vercel بالتحديث التلقائي خلال ثوانٍ.
echo ==============================================================================
pause

